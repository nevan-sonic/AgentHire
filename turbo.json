{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["NEXT_PUBLIC_API_URL"]
    },
    "@agenthire/api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "API_PORT",
        "NODE_ENV",
        "HEDERA_NETWORK",
        "HEDERA_OPERATOR_ID",
        "HEDERA_OPERATOR_KEY",
        "HEDERA_MIRROR_NODE_URL",
        "HEDERA_DIAGNOSTICS_ENABLED",
        "X402_ENABLED",
        "X402_MERCHANT_ID",
        "POCP_TEST_PRICE_TINYBARS",
        "MARKETPLACE_LIVE_ENABLED",
        "MARKETPLACE_OPERATOR_TOKEN",
        "X402_PAYER_ID",
        "X402_PAYER_KEY",
        "GROQ_GOALS_ENABLED",
        "RESEARCH_LIVE_ENABLED",
        "RESEARCH_QUICK_MERCHANT",
        "RESEARCH_DEEP_MERCHANT",
        "RESEARCH_QUICK_PORT",
        "RESEARCH_DEEP_PORT",
        "GROQ_API_KEY",
        "GROQ_MANAGER_MODEL",
        "GROQ_WORKER_MODEL",
        "GROQ_VERIFIER_MODEL",
        "WLD_APP_ID",
        "WLD_RP_ID",
        "WLD_RP_SIGNING_KEY",
        "WLD_PUBLISH_ACTION",
        "WLD_ENVIRONMENT",
        "MARKETPLACE_WORKER_CLAIMS_DATABASE_URL",
        "ENS_NETWORK",
        "ENS_RPC_URL",
        "MARKETPLACE_EXTERNAL_WORKER_ORIGIN"
      ]
    },
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NEXT_PUBLIC_API_URL"
      ]
    },
    "lint": {},
    "test": {},
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    }
  }
}
