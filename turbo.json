{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["NEXT_PUBLIC_API_URL"]
    },
    "@agenthire/api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "API_PORT",
        "NODE_ENV",
        "HEDERA_NETWORK",
        "HEDERA_OPERATOR_ID",
        "HEDERA_OPERATOR_KEY",
        "HEDERA_MIRROR_NODE_URL",
        "HEDERA_DIAGNOSTICS_ENABLED",
        "X402_ENABLED",
        "X402_MERCHANT_ID"
      ]
    },
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NEXT_PUBLIC_API_URL"
      ]
    },
    "lint": {},
    "test": {},
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    }
  }
}
