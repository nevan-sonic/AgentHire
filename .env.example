# Optional API port override. Copy to .env in the repository root.
API_PORT=3001

# Hedera testnet. Set credentials only in your ignored local .env file.
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
HEDERA_DIAGNOSTICS_ENABLED=false
