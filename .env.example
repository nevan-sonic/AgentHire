# Optional API port override. Copy to .env in the repository root.
API_PORT=3001

# Hedera testnet. Set credentials only in your ignored local .env file.
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
HEDERA_DIAGNOSTICS_ENABLED=false

# Optional HTS demo settings for an existing testnet token and separate recipient.
HEDERA_HTS_TOKEN_ID=
HEDERA_HTS_RECIPIENT_ID=
HEDERA_HTS_RECIPIENT_KEY=

# Set after a successful HCS topic creation receipt.
HEDERA_HCS_TOPIC_ID=

# Local x402 worker. The dedicated payer key is used by the CLI only.
X402_ENABLED=false
X402_MERCHANT_ID=
X402_PAYER_ID=
X402_PAYER_KEY=

# Paid PoCP stays disabled until one test is explicitly authorized.
POCP_TEST_PRICE_TINYBARS=5000
POCP_LIVE_ENABLED=false
POCP_LIVE_TASK_ID=
POCP_LIVE_AUTHORIZED_PRICE_TINYBARS=
POCP_LIVE_MAX_TOTAL_TINYBARS=
POCP_LIVE_FINAL_HIRE_RESERVE_TINYBARS=
POCP_LIVE_EXPIRES_AT=
