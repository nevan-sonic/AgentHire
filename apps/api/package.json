    "agents:demo": "tsx src/cli/agents-demo.ts",
    "pocp:demo": "tsx src/cli/pocp-demo.ts",
    "pocp:paid-demo": "tsx src/cli/paid-pocp-demo.ts",
    "procurement:complete": "tsx src/cli/procurement-complete.ts",
    "marketplace:operator": "tsx src/marketplace/operator.ts",
    "research:operator": "tsx src/goals/research-operator.ts",
    "research:worker": "tsx src/goals/research-worker-main.ts",
